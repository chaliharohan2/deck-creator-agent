# deck-agent settings. Copy this file to .env (git ignores .env) and fill it in:
#     cp .env.example .env
# Variables already set in your shell take precedence over this file.

# Where the model runs when deck-agent starts:
#   cpu    - a model on this computer, served by Ollama
#   server - your remote GPU server (vLLM or another OpenAI-compatible API)
# Switch at any time with the CPU / GPU server switch in the web UI, or --mode on the command line.
DECK_AGENT_MODE=cpu

# ---------------------------------------------------------------- CPU mode (local Ollama)
DECK_AGENT_MODEL=qwen3.5:9b
# DECK_AGENT_BASE_URL=http://localhost:11434
# DECK_AGENT_NUM_CTX=32768

# ---------------------------------------------------------------- server mode (remote GPU server)
# Base URL of the server; "/v1" is added if missing. Prefer https:// or an SSH tunnel (see README:
# with plain http the API key and your deck content travel unencrypted).
DECK_AGENT_SERVER_URL=https://gpu.example.com
DECK_AGENT_SERVER_API_KEY=replace-with-your-api-key
# Model name exactly as the server serves it (vLLM: the model path or --served-model-name).
# Leave empty to use the first model the server offers.
DECK_AGENT_SERVER_MODEL=
# DECK_AGENT_SERVER_BACKEND=openai       # "ollama" for an Ollama server behind an authenticating proxy
# DECK_AGENT_SERVER_AUTH_HEADER=         # send the key in this header instead of "Authorization: Bearer <key>"
# DECK_AGENT_SERVER_NUM_CTX=32768        # keep at or below the server's --max-model-len
# DECK_AGENT_SERVER_THINK=false          # reasoning mode: better plans, longer steps (affordable on a GPU)
#
# VLLM_BASE_URL, VLLM_API_KEY and MODEL_NAME are also understood, if you already use those names.

# ---------------------------------------------------------------- optional
# DECK_AGENT_WEB=true                    # web research
# DECK_AGENT_FORMATS=pptx,pdf            # output formats for `deck-agent run`
# DECK_AGENT_OUTPUT_DIR=decks
